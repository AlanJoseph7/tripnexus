{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/tripnexus/dist/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
